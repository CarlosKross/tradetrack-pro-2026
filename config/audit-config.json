{
  "appId": "tradetrack-pro-2026",
  "version": "1.2.0",
  "auditType": "horeca_pdv",
  "configVersion": "1.2.0",
  "offline": {
    "enabled": true,
    "maxLocalAudits": 15,
    "syncOnConnect": true
  },
  "photos": {
    "maxWidthPx": 1280,
    "jpegQuality": 0.7,
    "watermark": {
      "enabled": true,
      "includeDateTime": true,
      "includeUserId": true,
      "includePdvId": true,
      "includeGps": true
    }
  },
  "scoring": {
    "max": 100,
    "categories": [
      { "name": "Bronce", "min": 0,  "max": 50,  "color": "#CD7F32", "emoji": "🥉" },
      { "name": "Plata",  "min": 51, "max": 80,  "color": "#C0C0C0", "emoji": "🥈" },
      { "name": "Oro",    "min": 81, "max": 100, "color": "#FFD700", "emoji": "🥇" }
    ]
  },
  "pdvSelector": {
    "searchFields": ["pdvId", "name", "fantasyName", "executiveName", "address", "zone", "comuna"],
    "displayFields": ["fantasyName", "executiveName", "name", "pdvId", "address", "zone"],
    "minChars": 2,
    "maxResults": 10
  },
  "user": {
    "userId": "USR-1029",
    "name": "Usuario Demo"
  },
  "sections": [
